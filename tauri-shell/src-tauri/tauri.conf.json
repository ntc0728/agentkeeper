{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentKeeper",
  "version": "0.2.1",
  "identifier": "dev.agentkeeper",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node copy-frontend.js",
    "beforeDevCommand": "node copy-frontend.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/agentkeeper-mcp",
      "binaries/ak-scan"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
