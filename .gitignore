# ---- dependencies ----
node_modules/

# ---- build outputs ----
# `release/` is where `npm run tauri:bundle` stages the shippable artifacts:
#   release/AgentKeeper_<ver>_x64-setup.exe      NSIS installer
#   release/AgentKeeper_<ver>_x64-portable.zip   install-free archive
# Both are rebuilt from source in minutes, so they never enter the repository.
release/
*.exe
*.blockmap
# CI's artefact collection step (`Collect artefacts` in release.yml) writes here.
# It only runs in Actions, but the same commands run locally without warning.
dist-artifacts/

# ---- Tauri / Rust build artifacts (large after one release build) ----
# 只提交 src/、Cargo.toml/lock、tauri.conf.json、capabilities。
#
# `tauri-shell/dist/` 是**生成物**，不入库：它是 `src/renderer` 的逐字节副本，
# 而 `cargo tauri build` 直接把它编进可执行文件。入库的副本可能相对源码过期，
# 而构建过程不校验新鲜度——于是一份陈旧的界面会被悄悄打进安装包。
# `npm run tauri:sync` 在每次构建前重新生成它，`npm run tauri:check` 校验一致。
tauri-shell/dist/
#
# `tauri-shell/target/` 是 WORKSPACE 级的产物目录：cargo 把 core/ 与 src-tauri/
# 两个成员都编进同一个 target/，它不在这两个目录下面，而在它们的上一级。
tauri-shell/target/
tauri-shell/src-tauri/target/
tauri-shell/src-tauri/gen/
tauri-shell/node_modules/
*.pdb
#
# 任何位置的 `target/`：上面三条是已知路径，这一条是兜底。一个临时脚本若在仓库
# 根跑 `cargo build`（不带 workspace 的 target 目录），产物会落在 `./target/`，
# 而它既不被上面三条覆盖，也不在 `tauri-shell/` 下——没有这条就会被提交。
target/

# ---- demo data ----
# 示例内容的唯一真相是 `scripts/fixtures/`（测试输入），任何同名目录都不入库。
**/demo-projects/
demo/

# ---- local temporary artifacts ----
.tmp-*

# ---- generated screenshots ----
docs/ui-*.png
docs/screenshot.log

# ---- local state & secrets ----
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*credential*
*secret*
.claude/settings.local.json

# ---- OS / editor noise ----
Thumbs.db
.DS_Store
desktop.ini
*.log
*.tmp

# ---- probe / research artifacts ----
docs/probe-*.txt
docs/probe-*.json
docs/dashboard-preview.html

# ---- Tauri externalBin staging (produced by tauri-shell/stage-core-bins.js) ----
tauri-shell/src-tauri/binaries/

# ---- owner-only local knowledge base (never commit) ----
# Internal reports, dev-stage screenshots, real-machine verification harness and
# the delivery contract output live here. Public repo carries the product only.
.devkb/

# The workspace never creates a separate target/ for a member, but listing it
# costs nothing and protects against a future per-member target directory.
tauri-shell/core/target/

# 视觉回归比对的临时截图（capture/compare 之间用完即删）
.ui-baseline-tmp/
